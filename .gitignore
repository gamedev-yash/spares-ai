# Single .gitignore for the whole repository. Patterns are intentionally NOT
# root-anchored so they apply inside frontend/ and backend/ alike.

# --- Node / Next.js (frontend) ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.next/
out/
build/
coverage/
*.tsbuildinfo
next-env.d.ts
.vercel

# --- Python (backend) ---
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
env/

# --- Environment files ---
# Real env files are never committed. Only the two application templates are
# tracked -- scoped deliberately, so unrelated tools (e.g. data-generator/)
# keep their previous fully-ignored behaviour.
.env
.env.*
!/frontend/.env.example
!/backend/.env.example

# --- Misc ---
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
