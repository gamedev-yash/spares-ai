# Copy to .env for local development. NEVER commit the real .env file.
# There is no database and no Docker in this build -- CSV files under backend/data/ are the
# source of truth (see backend/README or PROMPT_SPEC.md).

AI_MODE=demo
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

SYNTHETIC_DATA_SEED=12345

# Frontend (Next.js) -- used by `npm run dev`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
