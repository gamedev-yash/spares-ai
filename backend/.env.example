# Copy to .env for local backend development. NEVER commit the real .env file.
# There is no database in this build -- CSV files under backend/data/ are the source of
# truth (see app/services/csv_store.py). No Docker either -- run `uvicorn app.main:app --reload`.

ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Defaults to backend/data -- uncomment and set only if you keep CSVs somewhere else.
# DATA_DIR=

SYNTHETIC_DATA_SEED=12345

# AI_MODE=demo runs a deterministic, no-key-required assistant and is clearly labeled as such in the UI.
# Set AI_MODE=provider (and the matching API key below) to use a real LLM.
AI_MODE=demo
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
